# =====================================================================
# Copy file này thành `application.properties` hoặc dùng trực tiếp qua env.
# KHÔNG commit secret thật. Mọi key dưới đây đều có thể đặt qua biến môi trường.
# =====================================================================
spring.application.name=booking-service

server.port=${SERVER_PORT:8080}

# Database
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/ttnails?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:root}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:change_me}
spring.datasource.driver-class-name=${SPRING_DATASOURCE_DRIVER_CLASS_NAME:com.mysql.cj.jdbc.Driver}

# JPA / Hibernate — schema do Flyway quản lý
spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:none}
spring.jpa.open-in-view=false
spring.jpa.show-sql=${SPRING_JPA_SHOW_SQL:false}
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.jpa.properties.hibernate.type.preferred_uuid_jdbc_type=CHAR

# Flyway
spring.flyway.enabled=${SPRING_FLYWAY_ENABLED:true}
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

# JWT — BẮT BUỘC đổi secret khi deploy (tối thiểu 64 ký tự base64/plain)
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_64_chars
JWT_VALID_DURATION=3600
JWT_REFRESH_DURATION=7200

# Admin seed (để trống -> mật khẩu ngẫu nhiên in 1 lần trong log)
ADMIN_PASSWORD=

# CORS — danh sách origin frontend, phân tách bằng dấu phẩy
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:3000,http://localhost:5173}

# Observability
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=${HEALTH_SHOW_DETAILS:never}
management.endpoint.health.probes.enabled=true

# OpenAPI
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
app.openapi.server-url=${APP_OPENAPI_SERVER_URL:http://localhost:8080}

# fiskaly SIGN DE (sandbox/production) — xem docs/tse/fiskaly-setup.md
fiskaly.enabled=${FISKALY_ENABLED:false}
fiskaly.base-url=${FISKALY_BASE_URL:https://kassensichv.io/api/v2}
fiskaly.api-key=${FISKALY_API_KEY:}
fiskaly.api-secret=${FISKALY_API_SECRET:}
fiskaly.tss-id=${FISKALY_TSS_ID:}
fiskaly.client-id=${FISKALY_CLIENT_ID:}
