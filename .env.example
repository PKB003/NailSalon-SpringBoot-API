# =====================================================================
# Docker Compose / Spring Boot environment variables
# Copy -> `.env` (đã gitignore) rồi điền giá trị thật.
# =====================================================================

# --- MySQL container ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ttnails

# --- Application datasource (trong docker network host = mysql) ---
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ttnails?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change_me_root
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# --- JPA / Flyway (schema do Flyway quản lý) ---
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false
SPRING_FLYWAY_ENABLED=true

# --- Server ---
SERVER_PORT=8080
HEALTH_SHOW_DETAILS=never

# --- JWT (BẮT BUỘC đổi; >= 64 ký tự) ---
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_64_chars
JWT_VALID_DURATION=3600
JWT_REFRESH_DURATION=7200

# --- Admin seed (production phải đặt) ---
ADMIN_PASSWORD=change_this_admin_password

# --- CORS ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- OpenAPI ---
APP_OPENAPI_SERVER_URL=http://localhost:8080
SPRINGDOC_ENABLED=true

# --- fiskaly SIGN DE (sandbox) — xem docs/tse/fiskaly-setup.md ---
FISKALY_ENABLED=false
FISKALY_BASE_URL=https://kassensichv.io/api/v2
FISKALY_API_KEY=
FISKALY_API_SECRET=
FISKALY_TSS_ID=
FISKALY_CLIENT_ID=
